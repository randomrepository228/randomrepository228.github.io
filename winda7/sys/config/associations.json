{
    "associations": {
        "dir": {
            "description": "Directory",
            "iconGenerator": false,
            "icon": "res/icons/dir.png",
            "run": "filemgr"
        },
        "file": {
            "description": "File \"%1\"",
            "iconGenerator": false,
            "icon": "res/icons/file.png",
            "run": "openwith"
        },
        ".js": {
            "description": "Executable file",
            "iconGenerator": false,
            "icon": "res/icons/file.png",
            "run": "exec"
        },
        ".webp": {
